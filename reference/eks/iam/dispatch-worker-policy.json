{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConsumeDispatchJobs",
      "Effect": "Allow",
      "Action": ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:ChangeMessageVisibility", "sqs:GetQueueAttributes"],
      "Resource": "arn:aws:sqs:eu-west-1:111122223333:dispatch-jobs"
    },
    {
      "Sid": "ReadRoutingTiles",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::larder-prod-routing-tiles/*"
    }
  ]
}
